                        },
                        {
                          "component": "li",
                          "innerHTML": "<strong>Multi-Database Support:</strong> Connect to MongoDB, Notion, PostgreSQL, or any data source"
                        },
                        {
                          "component": "li",
                          "innerHTML": "<strong>Security First:</strong> Component sandboxing, tenant isolation, and enterprise-grade security"
