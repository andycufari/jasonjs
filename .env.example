# ==============================================================================
# JasonJS — Environment Configuration
#
# JasonJS runs as a single instance serving one or more sites from the
# sites/ folder. Requests are routed to a site by their Host header;
# requests to localhost (or any unmatched host) fall back to DEFAULT_DOMAIN.
#
# Copy this file to .env and adjust. Only the CORE section is required to
# get started — everything else is optional and per-feature.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE
# ------------------------------------------------------------------------------

# Site served for localhost / unmatched hosts (must exist in sites/)
DEFAULT_DOMAIN=example.com

# Where site folders live (pages, components, functions, settings)
SITES_PATH=./sites

# Secret for session/JWT signing (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me

# ------------------------------------------------------------------------------
# DATABASE (app data — todos, orders, users, ...)
# ------------------------------------------------------------------------------

# app.db works with zero setup: by default records are stored as JSON files
# in sites/<domain>/data/<collection>.json — nothing to configure, great for
# dev and small sites.
#
# Set MONGODB_URI to upgrade app.db to MongoDB (production-grade: joins,
# full-text search, geospatial queries, large datasets). No other changes
# needed — the same site code runs on either store.
# MONGODB_URI=mongodb://localhost:27017/jason

# MongoDB database name (only used with MONGODB_URI; default: jasonjs_universal)
# MONGODB_DB_NAME=jason

# ------------------------------------------------------------------------------
# OPTIONAL — Security
# ------------------------------------------------------------------------------

# Key for encrypting site secrets at rest (64 hex chars).
# Generate: openssl rand -hex 32
# JASONJS_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — File storage (app.storage, S3-compatible)
# ------------------------------------------------------------------------------

# S3_BUCKET_NAME=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Serve uploaded assets from a CDN instead of S3 directly
# NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# OPTIONAL — Email (magic links, notifications)
# ------------------------------------------------------------------------------

# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=noreply@example.com

# ------------------------------------------------------------------------------
# OPTIONAL — Billing: Stripe (app.billing)
# Note: sites can also set these per-site in sites/<domain>/settings/.env
# and reference them from settings/billing.json via [[env.STRIPE_SECRET_KEY]].
# ------------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# OPTIONAL — Billing: MercadoPago (app.billing)
# ------------------------------------------------------------------------------

# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — AI (app.ai / /api/ai)
# Set at least one provider key to enable AI features.
# ------------------------------------------------------------------------------

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — Cache
# Redis is auto-detected: set REDIS_URL and the framework uses it for
# distributed caching; otherwise it falls back to in-memory cache.
# ------------------------------------------------------------------------------

# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# OPTIONAL — Mobile (native container bridge)
# Referenced from sites/<domain>/settings/mobile.json via
# [[env.MOBILE_BRIDGE_SECRET]].
# ------------------------------------------------------------------------------

# MOBILE_BRIDGE_SECRET=
